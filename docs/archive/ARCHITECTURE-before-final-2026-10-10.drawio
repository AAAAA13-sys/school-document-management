        <mxCell id="n25" value="Private storage + configured malware scanner&#10;UUID paths • SHA-256 integrity&#10;Pending/failed/quarantined files blocked&#10;ClamAV command + scan-retry Artisan command" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1F4F2;strokeColor=#6E937B;fontColor=#173F30;fontSize=14;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="1110" width="770" height="150" />
        </mxCell>
        <mxCell id="e26" value="metadata / receipts" source="n10" target="n24" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#537561;fontColor=#173F30;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e27" value="workspace state" source="n11" target="n24" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#537561;fontColor=#173F30;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e28" value="grants / comments" source="n13" target="n24" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#537561;fontColor=#173F30;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e29" value="snapshot + history" source="n14" target="n24" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#537561;fontColor=#173F30;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e30" value="store / scan" source="n10" target="n25" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#537561;fontColor=#173F30;fontSize=12;labelBackgroundColor=#FFFFFF;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n31" value="Implementation is Laravel MVC with a service, not fully isolated Clean Architecture. Eloquent handles user identity; remaining persistence predominantly uses the query builder. File scanning is a security control, not business approval. TLS, restore tests, monitoring and live API adapters remain deployment work." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF4C7;strokeColor=#6E937B;fontColor=#173F30;fontSize=13;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1290" width="1620" height="80" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
