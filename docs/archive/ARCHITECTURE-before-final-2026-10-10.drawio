        <mxCell id="n2" value="School Document Management System | PHP 8.2 / Laravel 12 | 10 October 2026" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#173F30;fontSize=14;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="85" width="1620" height="35" />
