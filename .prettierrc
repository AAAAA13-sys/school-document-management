{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "es5",
    "printWidth": 160,
    "bracketSameLine": true,
    "plugins": ["prettier-plugin-blade"],
    "overrides": [
        {
            "files": ["*.blade.php"],
            "options": {
                "parser": "blade",
                "tabWidth": 4,
                "printWidth": 160,
                "bracketSameLine": true
            }
        },
        {
            "files": ["*.json", "*.md", "*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2,
                "singleQuote": false,
                "printWidth": 100
            }
        },
        {
            "files": ["*.js", "*.mjs", "*.css"],
            "options": {
                "tabWidth": 2,
                "singleQuote": true,
                "printWidth": 100
            }
        }
    ]
}
