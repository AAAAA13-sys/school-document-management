APP_NAME="PLP Documents"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
DMS_INVITATION_EXPIRY_HOURS=24
DMS_INVITATION_DISPATCH_ENABLED=false
MAIL_TIMEOUT=15
APP_URL=http://localhost

# Required only for `php artisan db:seed` demo accounts.
DMS_DEMO_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dms
DB_USERNAME=dms_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Keep log for general local development. Invitations require smtp and the
# separate dispatch gate; log/array/failover never count as invitation delivery.
MAIL_MAILER=log
# SMTP providers commonly use smtp (STARTTLS) or smtps (implicit TLS).
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=null

# Local ClamAV; quote absolute paths containing spaces.
CLAMAV_BINARY=clamscan
CLAMAV_DATABASE=
FRESHCLAM_BINARY=freshclam
FRESHCLAM_CONFIG=
DMS_PREVIEW_MIMES=application/pdf,image/png,image/jpeg,image/gif,image/webp,text/plain,text/csv,application/json
SESSION_SECURE_COOKIE=true
